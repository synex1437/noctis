#!/bin/sh
# The kernel (Linux 6.1 or later), the shell's OSTYPE (macOS) or bash's OSTYPE and HOSTTYPE (Linux,
# Git Bash, Cygwin) name this OS and CPU without starting another program; uname answers otherwise.
# On macOS the CPU does not matter: bin/darwin/noctis is one universal binary, and macOS runs the
# build in it for this CPU.
case $0 in
  */*) bin=${0%/*} ;;
  *) bin=. ;;
esac
kernel=/proc/sys/kernel
os= arch=
if [ -r "$kernel/ostype" ] && [ -r "$kernel/arch" ]; then
  read -r os <"$kernel/ostype"
  read -r arch <"$kernel/arch"
else
  case ${OSTYPE-} in
    darwin*) os=Darwin arch=universal ;;
    linux*|msys|cygwin)
      case ${HOSTTYPE-} in
        x86_64|aarch64) os=$OSTYPE arch=$HOSTTYPE ;;
      esac
      ;;
  esac
fi
if [ -z "$os" ] || [ -z "$arch" ]; then
  system=$(uname -sm)
  os=${system%% *} arch=${system##* }
fi
ext=
case $os in
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*|msys|cygwin) os=windows ext=.exe ;;
  *) os=linux ;;
esac
case $os:$arch in
  darwin:*) platform=darwin ;;
  *:x86_64|*:amd64) platform=$os-amd64 ;;
  *:arm64|*:aarch64) platform=$os-arm64 ;;
  *) echo "noctis: no build for this CPU ($arch); builds exist for amd64 and arm64" >&2; exit 1 ;;
esac
binary=$bin/$platform/noctis$ext
if [ ! -f "$binary" ] && [ "$os" = windows ] && [ -f "$bin/noctis.exe" ]; then
  binary=$bin/noctis.exe
fi
if [ ! -f "$binary" ]; then
  echo "noctis: no binary for $platform at $binary" >&2
  exit 1
fi
[ -x "$binary" ] || chmod +x "$binary" 2>/dev/null
exec "$binary" "$@"
