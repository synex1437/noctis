{
  "locale": "auto",
  "mode": "enforce",
  "thresholds": {
    "session5h": 92,
    "weeklyAll": 95,
    "weeklyFable": 97
  },
  "credits": {
    "allowPaid": false,
    "ceiling": 100,
    "fanOutHeadroom": 15
  },
  "roles": {
    "profile": "code",
    "code": {
      "model": "opus",
      "effort": "xhigh"
    },
    "research": {
      "model": "sonnet",
      "effort": "high"
    },
    "planning": {
      "model": "opus"
    },
    "digest": {
      "model": "haiku"
    },
    "explore": {
      "model": "haiku"
    },
    "fallback": {
      "model": "opus",
      "effort": "xhigh"
    }
  },
  "models": {
    "primary": "opus",
    "fallback": "opus",
    "effort": "xhigh",
    "scopedPattern": "fable",
    "scopedLabel": "Fable"
  },
  "router": {
    "enabled": false,
    "agent": "lite",
    "minPromptLength": 15,
    "shortQuestionWords": 20,
    "maxDeniesPerPrompt": 3,
    "digest": true,
    "digestAgent": "digest",
    "subagentModels": {
      "Explore": "haiku",
      "Plan": "opus"
    }
  },
  "fable": {
    "source": "oauth",
    "pollMinutes": 10,
    "revertOnReset": true,
    "autoRelaunch": true
  },
  "usage": {
    "staleMinutes": 20,
    "blindProbeSeconds": 60,
    "blindProbeRounds": 5,
    "multiSessionMax": true
  },
  "wait": {
    "maxInHookMinutes": 330,
    "earlyResetPollMinutes": 5,
    "retryMinutes": [
      10,
      20,
      30,
      45,
      60
    ],
    "resetMarginSeconds": 90,
    "builtinGraceSeconds": 180,
    "heartbeatGraceSeconds": 45,
    "workspaceGuard": true
  },
  "overload": {
    "baseSeconds": 30,
    "maxSeconds": 300,
    "maxTotalMinutes": 120
  },
  "wake": {
    "sameSession": true,
    "maxMinutes": 330,
    "graceSeconds": 300
  },
  "resume": {
    "mode": "window",
    "terminal": "auto",
    "closePrevious": true,
    "permissionMode": "inherit",
    "prompt": "Continue. The task was paused at a usage-limit threshold; pick up exactly where you left off and finish the pending work.",
    "remoteControl": false,
    "extraArgs": [],
    "copilotAllowAllTools": false,
    "freshAfterMinutes": 60,
    "freshAboveTokens": 100000
  },
  "budget": {
    "dailyWeeklyPercent": 0,
    "hardStop": false
  },
  "burn": {
    "alarm": true,
    "lookbackHours": 3,
    "stopSubagents": 0.5
  },
  "subagents": {
    "guard": true,
    "perSessionWarn": 10,
    "perSessionDeny": 20,
    "perHourWarn": 6,
    "perHourDeny": 12,
    "weeklyRoom": 15,
    "maxToolCalls": 60,
    "maxContextTokens": 120000,
    "graceToolCalls": 10,
    "compactWindow": 200000,
    "budgets": {
      "noctis:lite": {
        "maxToolCalls": 20,
        "reportWords": 450
      },
      "noctis:worker": {
        "reportWords": 300
      }
    },
    "exempt": [
      "noctis:digest"
    ]
  },
  "alarm": {
    "enabled": true,
    "wakePc": true,
    "webhookUrl": "",
    "webhook": {
      "url": "",
      "preset": "generic",
      "chatId": ""
    },
    "digestAt": ""
  },
  "statusline": {
    "chainCommand": "",
    "emoji": true,
    "mode": "own",
    "pace": true
  },
  "report": {
    "pricing": {}
  },
  "queue": {
    "enabled": true,
    "auto": true,
    "files": [
      "TASKS.md",
      "tasks.md",
      ".claude/TASKS.md",
      "docs/TASKS.md"
    ],
    "maxIdleContinues": 3,
    "maxContinuesPerSession": 200,
    "maxContinuesPerDay": 600,
    "subagentAboveTokens": 0,
    "escalate": "auto",
    "maxEscalationsPerDay": 5,
    "completionPromise": "",
    "github": {
      "closeOnDone": false,
      "comment": "Completed by Claude Code (noctis queue)."
    },
    "requireTrust": true,
    "headless": false,
    "verifyCommand": "",
    "verifyEachCommand": "",
    "verifyFullEvery": 5,
    "verifySkipUnchanged": true,
    "fileVerify": true,
    "verifyTimeoutSeconds": 900,
    "verifyAttempts": 2,
    "guardTests": true
  },
  "update": {
    "check": true,
    "url": "https://raw.githubusercontent.com/synex1437/noctis/main/.claude-plugin/plugin.json"
  },
  "workflow": {
    "suggest": false,
    "gate": true,
    "size": "medium"
  },
  "checkpoint": {
    "gitSnapshot": false
  },
  "compaction": {
    "contextPercent": 85,
    "compactAt": 280000,
    "lean": true,
    "earlyAtPercent": 90,
    "keepTurns": 6,
    "maxToolResultChars": 2000,
    "instructions": "Write the summary in short sections: the user's requests and intent, quoting any requirement they set; the task or queue item in hand, its acceptance criteria, what is done and what is left; each file changed or created and why; each build, test or check command run and its exit status, marking any that timed out, were killed or exited non-zero as UNVERIFIED, to be run again; errors met and how each was fixed, quoting any not fixed yet; decisions and approaches ruled out, each with its reason; open questions; the next step. Leave out file contents, tool output and search results that can be read again."
  }
}
