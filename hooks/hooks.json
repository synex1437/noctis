{
  "description": "noctis: usage-limit guard, scoped-model fallback, research router, queue mode",
  "modules": [
    "./lean.js"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "ensure"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 21600,
            "statusMessage": "noctis"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch|Agent|Task|Workflow|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 21600,
            "statusMessage": "noctis"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Edit|MultiEdit|AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 21600
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Read|Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 21600,
            "statusMessage": "noctis"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit|overloaded|server_error|model_not_found|billing_error|account_on_hold|authentication_failed|invalid_request|max_output_tokens|verification_required|oauth_org_not_allowed|cloud_credential_error|unknown",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 21600,
            "async": true,
            "asyncRewake": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled|permission_prompt|worker_permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 20,
            "async": true
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/noctis",
            "args": [
              "hook"
            ],
            "timeout": 21600,
            "statusMessage": "noctis"
          }
        ]
      }
    ]
  }
}