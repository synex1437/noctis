#!/bin/sh
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ext=
case "$(uname -s)" in
  Darwin) os=darwin ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ext=.exe ;;
  *) os=linux ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) echo "noctis: no build for this CPU ($(uname -m)); builds exist for amd64 and arm64" >&2; exit 1 ;;
esac
binary="$root/bin/$os-$arch/noctis$ext"
if [ ! -f "$binary" ] && [ "$os" = windows ] && [ -f "$root/bin/noctis.exe" ]; then
  binary="$root/bin/noctis.exe"
fi
if [ ! -f "$binary" ]; then
  echo "noctis: no binary for $os-$arch at $binary" >&2
  exit 1
fi
[ -x "$binary" ] || chmod +x "$binary" 2>/dev/null
exec "$binary" "$@"
